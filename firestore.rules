rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Anyone can create an order from the landing page.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId is string
                    && request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string;
      allow read, update, delete: if true;
    }

    // Combos collection: Publicly readable for storefront, manageable from admin dashboard.
    match /combos/{comboId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Products collection: Publicly readable, manageable from admin dashboard.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
